rules_version = '2';
// Jeff publishes these in Firebase console → Firestore → Rules after merge.
// The app does not deploy rules.
//
// Office (read + write all jobs):
//   jefflamb1992@gmail.com
//   info@breathe-easyhk.com
//   ruby@breathe-easyhk.com
//   perry@breathe-easyhk.com
//   n.marie.lamb@gmail.com
// Josh: read all jobs, no write (joshua@breathe-easyhk.com)
// Five leads: read only jobs where team_lead is their name. No write.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isOffice() {
      return signedIn() && email() in [
        'jefflamb1992@gmail.com',
        'info@breathe-easyhk.com',
        'ruby@breathe-easyhk.com',
        'perry@breathe-easyhk.com',
        'n.marie.lamb@gmail.com'
      ];
    }
    function isJosh() {
      return signedIn() && email() == 'joshua@breathe-easyhk.com';
    }
    function leadName() {
      return email() == 'matthewgross2001@gmail.com' ? 'Matthew'
        : email() == 'tiagogiri334@gmail.com' ? 'Tiago'
        : email() == 'neltrestium@gmail.com' ? 'Nick'
        : email() == 'sudor23@gmail.com' ? 'Alun'
        : email() == 'iggi.king@gmail.com' ? 'Iggi'
        : '';
    }
    function isLead() {
      return signedIn() && leadName() != '';
    }

    match /jobs/{jobId} {
      allow read: if isOffice()
        || isJosh()
        || (isLead() && resource.data.team_lead == leadName());
      allow write: if isOffice();
    }
  }
}
